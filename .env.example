# Copy to .env in the repo root or into each service. Never commit real values.

# --- Gateway (BFF) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001
CATALOG_BASE_URL=http://127.0.0.1:8002
AI_SERVICE_BASE_URL=http://127.0.0.1:8003
KIOSK_DEVICE_TOKEN=change-me-kiosk-device-token
AUTH_DEV_BYPASS=false
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
LOG_LEVEL=INFO

# --- Catalog ---
CATALOG_HOST=0.0.0.0
CATALOG_PORT=8002
CATALOG_DATA_DIR=backend/data/catalog
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8002

# --- AI service ---
AI_HOST=0.0.0.0
AI_PORT=8003
AI_DATA_DIR=backend/data/ai
# Stage B: set OPENAI_API_KEY (gpt-image-1 drape) and/or FAL_KEY (FASHN v1.6).
# Overlay stub is off unless TRYON_ALLOW_STUB=true.
OPENAI_API_KEY=
FAL_KEY=
TRYON_VENDOR_URL=
TRYON_VENDOR_API_KEY=
TRYON_VENDOR_TIMEOUT_SECONDS=120
TRYON_ALLOW_STUB=false

# --- Frontend (also copy keys into frontend/.env.local) ---
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8001
NEXT_PUBLIC_KIOSK_DEVICE_TOKEN=change-me-kiosk-device-token
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_DEV_BYPASS=false
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=10
